{
  "name": "website-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ./node_modules/typescript/bin/tsc",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k -n TSC,SERVER -c blue,green \"node ./node_modules/typescript/bin/tsc --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/index.js\"",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.2",
    "typescript": "^5.9.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.16"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
