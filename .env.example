NODE_ENV=development
PORT=4000

CORS_ORIGIN=http://localhost:3000

# Set EASYPAISA_MOCK_MODE=true for offline local testing without live Easypaisa credentials
EASYPAISA_MOCK_MODE=true

EASYPAISA_USERNAME=YOUR_EASYPAISA_USERNAME
EASYPAISA_PASSWORD=YOUR_EASYPAISA_PASSWORD
EASYPAISA_STORE_ID=12345
EASYPAISA_MERCHANT_EWP_ACCOUNT=03001234567

EASYPAISA_BASE_URL=https://easypaystg.easypaisa.com.pk/easypay-service/rest/v4

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
CONTACT_FORM_RECEIVER=admin@example.com
